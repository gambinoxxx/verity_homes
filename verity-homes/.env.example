# Copy to .env.local (never commit real values).
# lib/env.ts validates these in groups. Only the CORE group is needed to build and run the
# public site; each feature group is checked the first time that feature is used, and the
# error names any missing variable.

# ============ CORE — required for every build and page (Units 1–2) ============
# --- Neon Postgres ---
# Pooled URL (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/verity?sslmode=require"
# Direct URL (no "-pooler") — Prisma migrations only (optional for the app itself)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/verity?sslmode=require"
# Public site URL (canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Random 32+ character string used to hash IPs for rate limiting (16 minimum)
IP_HASH_SALT="change-me-to-a-long-random-string"

# ============ FEATURE — needed only when the feature is built ============
# --- Resend: enquiry notification emails — Unit 7 (read only by lib/email) ---
RESEND_API_KEY="re_..."
ENQUIRY_NOTIFY_TO="info@verityhomes.com.ng"
ENQUIRY_FROM="Verity Website <website@verityhomes.com.ng>"

# --- Clerk: admin sign-in — Unit 12 (read only by lib/auth) ---
# Turn OFF public sign-ups in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/sign-in"

# --- Vercel Blob: property photos, blog covers, logos — Unit 15 (read only by lib/storage) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
